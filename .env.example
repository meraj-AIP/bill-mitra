# Bill Mitra settings. Copy to .env and fill what you have.
# Every key is optional. With no keys the app runs in demo mode.

# OpenAI: reads bill photos (vision model) and writes explanations (text model)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_VISION_MODEL=gpt-4.1
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Sarvam: Telugu text to speech for voice notes
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=kavya
SARVAM_PACE=0.95

# Soniox: speech to text for voice questions
SONIOX_API_KEY=
SONIOX_BASE_URL=https://api.soniox.com
SONIOX_MODEL=stt-async-v5

# WhatsApp Cloud API. The adapter turns on when token, phone number id and verify token are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose. Meta sends it back when you register the webhook.
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app, used to check the X-Hub-Signature-256 header
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_URL=https://graph.facebook.com/v21.0

# Storage and server
# SQLite database and media files (default: backend/var)
# DATA_DIR=backend/var
# Postgres instead of the SQLite file in DATA_DIR. Empty means SQLite.
# DATABASE_URL=postgresql://billmitra:change-me@127.0.0.1:5432/billmitra
# DATABASE_POOL_SIZE=10
# FRONTEND_DIST=frontend/dist
# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
REQUEST_TIMEOUT_S=45
# A dashboard upload waits this long, then finishes the read in the background
UPLOAD_READ_DEADLINE_S=50
MAX_UPLOAD_MB=12

# First admin, created on startup when no admin exists. Change the password after first sign in.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-random-value
# Demo servers only: keeps one sample login per role with this password and lists the logins on the sign in
# page. Leave empty anywhere real consumers' bills are kept.
DEMO_ACCOUNTS_PASSWORD=
# Set true when served over HTTPS so the session cookie is never sent in clear text.
COOKIE_SECURE=false
# Approved WhatsApp template used for complaint replies outside the 24 hour service window.
WHATSAPP_COMPLAINT_TEMPLATE=

# Days an officer has to answer a complaint before it shows as overdue.
COMPLAINT_REPLY_DAYS=7
# The WhatsApp number shown to consumers so they can complain there (digits only, optional).
WHATSAPP_DISPLAY_NUMBER=

# DISCOM billing records for the review evidence pack. Leave both empty when not connected.
BILLING_RECORDS_URL=
BILLING_RECORDS_TOKEN=

# development (default) or production. Production refuses to start with OWNERSHIP_CHECK=false or no HASH_PEPPER.
APP_ENV=development
# Development only: false serves bills already in this database for a service number, with no ownership check.
OWNERSHIP_CHECK=true
# Any long random string. Mixed into service number and mobile hashes.
HASH_PEPPER=
# DISCOM bill and registered mobile lookup by service number. Leave both empty when not connected.
DISCOM_BILLS_URL=
DISCOM_BILLS_TOKEN=
# Approved WhatsApp authentication template for one-time codes. Empty means codes cannot be sent.
WHATSAPP_CODE_TEMPLATE=
# SMS gateway for consumer sign in codes: POST {to, sender, template_id, variables: {code}} with a Bearer key.
# Leave URL and key empty when not connected. With neither SMS nor WhatsApp, a development server shows the code on
# screen and a production server refuses to send codes.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
